# Object lifecycle: dataset row -> gradient. WHERE each object is born, what it
# carries, and where domain knowledge enters/exits.
# Verified against infra/envs/{base,math_env}.py, infra/envs/debate/{env,round}.py,
# infra/rl/datums.py, infra/train.py.
# Render: d2 --watch docs/objects.d2

direction: down

row: {
  label: "dataset row\n(HF / JSONL)"
  style.fill: "#fff4e6"
}

task: {
  label: "Task — family.source().tasks()\nmessages: RLVR prompt\nmeta: question, gt|tests, [gold, distractor]"
  style.fill: "#fff4e6"
}

state: {
  label: "DebateState — DebateEnv._build_state(task)\none per (task x arm x group member); THE mutable object\nbindings[speaker]: NAME, TOPIC, POSITION (strings only)\nrecords: list[SlotRecord] (append-only)\nfailed: str | None"
}

record: {
  label: "SlotRecord — DebateRound._ingest, one per protocol slot\ntext / thinking (never rendered onward)\nextracted + answer_format_valid <- family parse | verdict parser\nsample + datum (trained seats only)"
}

traj: {
  label: "Trajectory — DebateEnv._trajectories, one per trained seat\ndatums (that seat's slots) + reward (ladder + shaping)\ninfo: seat, cell, judge_conf, solution_correct"
}

datum: {
  label: "Datum — born in PolicySeat.generate; advantages filled by grpo_pack\ntokens, prompt_len, sampler_logprobs, advantages, mask\ntoken ids + floats ONLY — domain cannot cross this line"
  style.fill: "#e6f0ff"
}

grad: {
  label: "optim step\n(backend)"
  style.fill: "#e6f0ff"
}

row -> task: "family.source() parses the dataset"
task -> state: "meta -> bindings (question -> TOPIC)"
state -> record: "ONE DebateRound drives ALL states, slot by slot"
record -> traj: "verdict -> ladder; family.grade_batch() -> metric"
traj -> datum: "grpo_pack: center within (task, arm, seat) group"
datum -> grad: "forward_backward x N, optim_step"

domain: {
  label: "Domain knowledge lives ONLY here\n1. Task.meta fields\n2. prompt template YAML\n3. family.parse_answers() -> SlotRecord answer fields\n4. family.grade_batch() -> info metric"
  style.fill: "#fff4e6"
}

domain -> task: {style.stroke-dash: 4}
domain -> record: {style.stroke-dash: 4}
domain -> traj: {style.stroke-dash: 4}
