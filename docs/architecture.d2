# Composition map — every edge is a verified call site (file:line in comments).
# ARROWS = CALL DIRECTION (data returns along the edge), not data flow.
# Render: d2 --watch docs/architecture.d2   (live-reload in browser)
# Updated for the TaskFamily registry (commit 952af8c).

direction: down

entry: Entry points {
  rd: run_debate.py\n(debate PC)
  rv: run_rlvr.py\n(RLVR baseline)
}

core: Task-agnostic core (tokens + scalars only) {
  train: "train() loop"
  pack: grpo_pack
  policy: Policy
  backend: Backend\n(tinker | verl)
}

family: TaskFamily registry — ALL domain knowledge {
  reg: "get_family(dataset.type)"
  fam: "MathFamily | CodeContestsFamily\nsource() extractor() grade() format_flags()"
  reg -> fam
}

source: task-source Env\n(MathEnv | CodeContests)\ntasks() + RLVR rollout()

debate: Debate stack (domain-blind) {
  env: DebateEnv
  round: DebateRound
  seats: PolicySeat | FrozenSeat
  judge: judge parse\n+ reward ladder\n(grammar-forced JSON)
}

apis: Frozen models\n(judge, opponent — API/vLLM)

# --- wiring ---
entry.rd -> family.reg: dataset.type # run_debate.py
entry.rv -> family.reg: dataset.type # run_rlvr.py:46
entry.rd -> core.train: builds DebateEnv + backend
entry.rv -> core.train: builds source env + backend # run_rlvr.py:86

family.fam -> source: "source(ds) builds" # tasks/math.py, tasks/codecontests.py

core.train -> debate.env: env.tasks / env.rollout (debate mode) # train.py:84
core.train -> source: env.rollout (RLVR mode) {
  style.stroke-dash: 3
}

# env.py: tasks() only; meta contract {question, gt|tests, [gold, distractor]}
debate.env -> source: "tasks() — dataset role"
debate.env -> family.fam: "extractor() at init; grade()/format_flags() post-round" # env.py

# DebateRound = the PROTOCOL MACHINE, built once per batch, task-data-free.
# Per-task data travels as DebateState.bindings (opaque strings).
debate.env -> debate.round: "built once w/ extractor\n+ verdict parser;\nrun(states)"
debate.round -> debate.seats: one batched generate per slot
debate.seats -> core.policy: trained seats # round.py
debate.seats -> apis: frozen seats
debate.env -> debate.judge: "verdict -> seat rewards"

core.policy -> core.backend: "sample()"
core.train -> core.pack: advantages into datums
core.train -> core.backend: forward_backward / optim_step
