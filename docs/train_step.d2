# One training step, as object lifetimes. Verified against infra/train.py:81-121,
# infra/envs/debate/env.py:109-196, infra/envs/debate/round.py:287-304.
# Render: d2 --watch docs/train_step.d2

shape: sequence_diagram

t: "train()"
b: Backend
e: DebateEnv
m: MathEnv (task source)
r: DebateRound
j: Judge (frozen API model)

t -> b: "sync_sampler() — sampler now serves last step's weights"
t -> e: tasks(batch_size)
e -> m: "tasks(n, train)"
m -> e: "list[Task]  (meta: gt, question)"
t -> e: rollout(tasks, policy, group_size)
e -> e: "build DebateStates: bindings per speaker, group ids (task, arm, seat)"
e -> r: run(states)

slots: "loop: each compiled protocol slot (all live debates batched)" {
  r -> b: "trained seat: Policy.predict -> backend.sample (Datum born here, advantages zeroed)"
  r -> j: "judge / frozen seat: Model.predict (no Datum)"
}

e -> e: "parse verdict (grammar-forced JSON) -> ladder + shaping -> one Trajectory per trained seat"
e -> e: "family.grade(meta, solution) -> solution_correct metric (info only, never reward)"
e -> t: "list[list[Trajectory]]  (failed/unscoreable debates dropped + counted)"
t -> t: "grpo_pack: center rewards per group, fill advantages, drop zero-variance"
t -> b: "forward_backward(micro) x N  (gradients accumulate)"
t -> b: "optim_step() -> new weights (picked up by next sync_sampler)"
